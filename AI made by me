local function escapeRich(s) return s:gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;") end
local function highlightLua(code)
    local ok,res=pcall(function()
        if code=="" then return "" end
        local prot={}; local c=0
        local function addProt(t,col) c+=1; local k="##P"..c.."##"; prot[k]='<font color="'..col..'">'..escapeRich(t)..'</font>'; return k end
        code=code:gsub("%-%-%[%[.-%]%]", function(m) return addProt(m,"#6A9955") end)
        code=code:gsub("%-%-[^\n]*", function(m) return addProt(m,"#6A9955") end)
        code=code:gsub("%[%[.-%]%]", function(m) return addProt(m,"#CE9178") end)
        code=code:gsub('%b""', function(m) return addProt(m,"#CE9178") end)
        code=code:gsub("%b''", function(m) return addProt(m,"#CE9178") end)
        code=escapeRich(code)
        code=code:gsub("%f[%d]%d+%.?%d*", function(n) return '<font color="#B5CEA8">'..n..'</font>' end)
        code=code:gsub("%f[%a_]([%a_][%w_]*)%f[^%w_]", function(w)
            if keywords[w] then return '<font color="#569CD6">'..w..'</font>' end
            if builtins[w] then return '<font color="#4EC9B0">'..w..'</font>' end
            return w
        end)
        for k,v in pairs(prot) do code=code:gsub(k,function() return v end) end
        return code
    end)
    if ok then return res else return escapeRich(code) end
end

